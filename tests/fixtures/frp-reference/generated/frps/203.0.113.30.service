[Unit]
Description=frps server on 203.0.113.30
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/srv/services/frp/bin/frps -c /srv/services/frp/generated/frps/203.0.113.30.toml
WorkingDirectory=/srv/services/frp
User=root
Restart=always
RestartSec=3s
KillMode=mixed
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
