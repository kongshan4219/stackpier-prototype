[Unit]
Description=frps server on 192.0.2.10
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/srv/services/frp/bin/frps -c /srv/services/frp/generated/frps/192.0.2.10.toml
WorkingDirectory=/srv/services/frp
User=root
Restart=always
RestartSec=3s
KillMode=mixed
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
