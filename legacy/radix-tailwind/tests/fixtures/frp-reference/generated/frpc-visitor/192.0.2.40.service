[Unit]
Description=frpc STCP visitor for 192.0.2.40
Wants=network-online.target
After=network-online.target 192.0.2.40.service

[Service]
Type=simple
ExecStart=/srv/services/frp/bin/frpc -c /srv/services/frp/generated/frpc-visitor/192.0.2.40.toml
WorkingDirectory=/srv/services/frp
User=root
Restart=always
RestartSec=3s
KillMode=mixed
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
